{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/CVS": true,
		"**/.DS_Store": true,
		"**/*.o": true,
		"**/*.exe": true
	},
	"clangd.path": "/usr/bin/clangd",
	"clangd.arguments": [
		"--compile-commands-dir=${workspaceFolder}",
		"--header-insertion=never",
		"--completion-style=detailed"
	]
}
